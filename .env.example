# Optional: copy to .env (git-ignored). Never commit .env.

# Data root. Default when unset: <repo>/data (git-ignored and blocked by the data guard).
# Override only to use another disk, e.g. on the GPU machine:
# ROADMARK_DATA_ROOT=E:/roadmark-data

# Keep ML tooling offline / local.
WANDB_MODE=disabled
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
